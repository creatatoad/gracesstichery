# ── Database ────────────────────────────────────────────────────────────────
# SQLite by default. Swap to Postgres in production by changing the provider
# in prisma/schema.prisma and pointing this at your database.
DATABASE_URL="file:./dev.db"

# ── Site ────────────────────────────────────────────────────────────────────
NEXT_PUBLIC_SITE_URL="https://gracesstitchery.com"

# ── Admin ───────────────────────────────────────────────────────────────────
# Required to log into /admin. Pick a long, unique password.
ADMIN_PASSWORD=""
# Optional: separate secret for signing the admin session cookie.
# Falls back to a key derived from ADMIN_PASSWORD if unset.
AUTH_SECRET=""

# ── Payments (Stripe) ───────────────────────────────────────────────────────
# Without these the site still works: orders are recorded and the customer is
# told they'll receive an invoice by email.
STRIPE_SECRET_KEY=""

# ── AI product descriptions & SEO (Anthropic) ───────────────────────────────
# Powers the "Generate with AI" button in the admin. Without a key the admin
# falls back to a solid built-in template.
ANTHROPIC_API_KEY=""

# ── Channel sync: Etsy ──────────────────────────────────────────────────────
# https://developers.etsy.com — Open API v3, OAuth 2.0 token with listings_w scope.
ETSY_API_KEY=""
ETSY_ACCESS_TOKEN=""
ETSY_SHOP_ID=""
# Etsy taxonomy id for your listings (default: clothing)
ETSY_TAXONOMY_ID="1"

# ── Channel sync: TikTok Shop ───────────────────────────────────────────────
# https://partner.tiktokshop.com — app key/secret + seller access token.
TIKTOK_APP_KEY=""
TIKTOK_APP_SECRET=""
TIKTOK_ACCESS_TOKEN=""
TIKTOK_SHOP_CIPHER=""
TIKTOK_WAREHOUSE_ID=""

# ── Channel sync: Webhook (Zapier / Make / custom) ──────────────────────────
# Receives the full product JSON on every publish/update. Use it to fan out
# to Shopify, Square, Instagram Shopping, Facebook Marketplace, etc.
WEBHOOK_SYNC_URL=""
WEBHOOK_SYNC_SECRET=""
