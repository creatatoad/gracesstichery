// Grace's Stitchery — data model
// SQLite for zero-config local/dev use. For production Postgres, change
// provider to "postgresql" and update DATABASE_URL — the schema is portable.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

model Product {
  id             String           @id @default(cuid())
  slug           String           @unique
  name           String
  description    String           @default("")
  priceCents     Int
  category       String           @default("apparel")
  status         String           @default("active") // draft | active | archived
  featured       Boolean          @default(false)
  // SEO
  seoTitle       String           @default("")
  seoDescription String           @default("")
  tags           String           @default("") // comma-separated keywords
  images         ProductImage[]
  channels       ChannelListing[]
  createdAt      DateTime         @default(now())
  updatedAt      DateTime         @updatedAt
}

model ProductImage {
  id        String  @id @default(cuid())
  productId String
  product   Product @relation(fields: [productId], references: [id], onDelete: Cascade)
  url       String
  alt       String  @default("")
  position  Int     @default(0)
}

// Tracks where a product has been published (Etsy, TikTok Shop, webhook…)
model ChannelListing {
  id           String    @id @default(cuid())
  productId    String
  product      Product   @relation(fields: [productId], references: [id], onDelete: Cascade)
  channel      String // etsy | tiktok | webhook
  externalId   String    @default("")
  status       String    @default("pending") // pending | live | error
  error        String    @default("")
  lastSyncedAt DateTime?

  @@unique([productId, channel])
}

model Order {
  id              String   @id @default(cuid())
  email           String   @default("")
  name            String   @default("")
  status          String   @default("pending") // pending | paid | invoice_requested | fulfilled | cancelled
  totalCents      Int
  itemsJson       String // [{productId, name, qty, priceCents}]
  stripeSessionId String   @default("")
  note            String   @default("")
  createdAt       DateTime @default(now())
}

model CustomOrderRequest {
  id          String   @id @default(cuid())
  name        String
  email       String
  description String
  budget      String   @default("")
  status      String   @default("new") // new | quoted | in_progress | done
  createdAt   DateTime @default(now())
}
